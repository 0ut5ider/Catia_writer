<script src="https://web.archive.org/web/20260906185703js_/https://scripts.wtwhmedia.com/wordpress-event-hub/more_like_this/env/prod/index.js"></script>
<script>
  const mlt = new window.MoreLikeThis({
    autoBoot: false,
    host: "https://web.archive.org/web/20260906185703/https://wpeventhub.wtwhmedia.com",
    containerId: "myNode",
    prepend: { enabled: false },
    removal: { enabled: false },
    params: {
      text: ["Catia File Contents &amp; Translation"],
      siteIdentifiers: ["ENGCOM","EE","DWD","CONTROLENG","PLANTENG","CSEMAG","EG"],
      limit: 4
    }
  });

  function normalizeUrl(rawUrl) {
    try {
      const url = new URL(rawUrl, window.location.origin);
      url.hash = "";
      return url.toString();
    } catch (e) {
      return rawUrl;
    }
  }

  function setupRecommendedContentTracking() {
    if (!window.posthog) {
      console.warn("PostHog is not available on window.posthog");
      return;
    }

    const container = document.getElementById("myNode");
    const titleEl = document.getElementById("myNodeTitle");

    if (!container) return;

    const widgetMeta = {
      widget_id: "recommended_content_myNode",
      widget_title: titleEl ? titleEl.textContent.trim() : "Recommended Content",
      page_url: window.location.href,
      page_path: window.location.pathname
    };

    let widgetImpressionTracked = false;
    let itemObserver = null;

    function getRecommendationItems() {
      return Array.from(
        container.querySelectorAll("article.more-like-this-article-item")
      );
    }

    function getItemData(article, index) {
      const titleLink = article.querySelector("a.more-like-this-title");
      const imageLink = article.querySelector("a.more-like-this-article-img-link");
      const ctaLink = article.querySelector("a.more-like-this-cta");
      const primaryLink =
        titleLink ||
        imageLink ||
        ctaLink ||
        article.querySelector("a[href]");

      const titleHeading = article.querySelector("h4");
      const itemTitle =
        (titleHeading && titleHeading.textContent.trim()) ||
        (titleLink && titleLink.textContent.trim()) ||
        "";

      return {
        destination_url: primaryLink ? normalizeUrl(primaryLink.href) : null,
        item_title: itemTitle,
        position: index + 1
      };
    }

    function trackWidgetImpressionWhenVisible() {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting || widgetImpressionTracked) continue;

          const items = getRecommendationItems();
          if (items.length === 0) continue;

          widgetImpressionTracked = true;

          window.posthog.capture("recommended_widget_impression", {
            ...widgetMeta,
            item_count: items.length
          });

          observer.disconnect();
        }
      }, {
        threshold: 0.5
      });

      observer.observe(container);
    }

    function observeItemImpressions() {
      const items = getRecommendationItems();

      if (itemObserver) {
        itemObserver.disconnect();
      }

      itemObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;

          const article = entry.target;
          if (article.dataset.phImpressionTracked === "1") continue;

          const itemsNow = getRecommendationItems();
          const index = itemsNow.indexOf(article);
          if (index < 0) continue;

          const item = getItemData(article, index);
          if (!item.destination_url) continue;

          article.dataset.phImpressionTracked = "1";

          window.posthog.capture("recommended_widget_item_impression", {
            ...widgetMeta,
            destination_url: item.destination_url,
            item_title: item.item_title,
            position: item.position
          });
        }
      }, {
        threshold: 0.5
      });

      items.forEach((article) => {
        itemObserver.observe(article);
      });
    }

    function trackClicks() {
      if (container.dataset.posthogClickBound === "1") return;
      container.dataset.posthogClickBound = "1";

      container.addEventListener("click", (event) => {
        const clickedLink = event.target.closest("a[href]");
        if (!clickedLink || !container.contains(clickedLink)) return;

        const article = clickedLink.closest("article.more-like-this-article-item");
        if (!article) return;

        const items = getRecommendationItems();
        const index = items.indexOf(article);
        if (index < 0) return;

        const item = getItemData(article, index);
        if (!item.destination_url) return;

        const properties = {
          ...widgetMeta,
          destination_url: item.destination_url,
          item_title: item.item_title,
          position: item.position,
          click_target_class: clickedLink.className || ""
        };

        const isModifiedClick =
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey ||
          event.button !== 0;

        const opensNewTab = clickedLink.target === "_blank";

        if (isModifiedClick || opensNewTab) {
          window.posthog.capture("recommended_widget_item_click", properties);
          return;
        }

        event.preventDefault();
        window.posthog.capture("recommended_widget_item_click", properties);

        setTimeout(() => {
          window.location.assign(clickedLink.href);
        }, 350);
      }, true);
    }

    function refreshTrackingOnRender() {
      const items = getRecommendationItems();
      if (items.length === 0) return;

      observeItemImpressions();
    }

    const mutationObserver = new MutationObserver(() => {
      refreshTrackingOnRender();
    });

    mutationObserver.observe(container, {
      childList: true,
      subtree: true
    });

    trackWidgetImpressionWhenVisible();
    trackClicks();
    refreshTrackingOnRender();
  }

  mlt.boot();

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupRecommendedContentTracking);
  } else {
    setupRecommendedContentTracking();
  }
</script>

